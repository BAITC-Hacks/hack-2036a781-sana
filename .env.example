# Скопировать в .env и вписать значения. .env в репозиторий не коммитится.

# Без ключа приложение работает в режиме fallback — сквозной сценарий доступен полностью
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Максимальное качество рассуждений. Для более дешёвой и быстрой работы: high или medium.
OPENAI_REASONING_EFFORT=max
OPENAI_MAX_OUTPUT_TOKENS=6000

# fallback — работа без обращений к модели (страховка на защите при проблемах с сетью)
AI_MODE=

REQUEST_TIMEOUT_SECONDS=120
APP_PORT=8000

# Рабочие данные по умолчанию хранятся в .sana-data/ вне Git.
SANA_DATA_DIR=

# PostgreSQL/Neon. Если строка задана, база заменяет локальные JSON-файлы.
DATABASE_URL=
